# Copy to .env and fill in. docker compose reads it automatically.
# Generate random values with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Encryption key for everything stored (recommended: keep a copy somewhere safe, NOT next to backups of the data volume)
DATACLEANER_SECRET_KEY=
SEARXNG_SECRET=

# The address you use to open Data Cleaner, if not http://localhost:8080
# DATACLEANER_BASE_URL=https://privacy.example.com

# Sign in with Google / Microsoft (or paste these on the Settings page instead). See README.
# DATACLEANER_GOOGLE_CLIENT_ID=
# DATACLEANER_GOOGLE_CLIENT_SECRET=
# DATACLEANER_MICROSOFT_CLIENT_ID=
# DATACLEANER_MICROSOFT_CLIENT_SECRET=
