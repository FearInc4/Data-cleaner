{
  "manifest_version": 3,
  "name": "Data Cleaner",
  "version": "0.1.0",
  "description": "Fills data broker opt-out forms from your own self-hosted Data Cleaner. You check the details and press Submit.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Data Cleaner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "datacleaner-extension@fearinc4.github.io",
      "strict_min_version": "128.0"
    }
  }
}
